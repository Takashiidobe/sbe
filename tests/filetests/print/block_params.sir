; check: function %loop(i64) -> i64 {
; nextln: block0(v0: i64):
; nextln:     jump block1(v0)
; check: block1(v1: i64):
; nextln:     v2 = iadd v1, v1
; nextln:     jump block1(v2)
function %loop(i64) -> i64 {
block0(v0: i64):
    jump block1(v0)

block1(v1: i64):
    v2 = iadd v1, v1
    jump block1(v2)
}
