; test wasm
; check: (func $$pick
; check: block
; check: if
; check: local.set $$v3
; check: br 1
; check: else
; check: local.set $$v3
; check: end
; check: end
; check: local.get $$v3
; check: return
function %pick(i64) -> i64 {
block0(v0: i64):
    brif v0, block1, block2

block1:
    v1 = iconst 10
    jump block3(v1)

block2:
    v2 = iconst 20
    jump block3(v2)

block3(v3: i64):
    return v3
}
