; test x86_64-error
; ten values are live at once but only nine registers are allocatable
; check: ran out of registers; spilling is not implemented
function %f() -> i64 {
block0:
    v0 = iconst i64 0
    v1 = iconst i64 1
    v2 = iconst i64 2
    v3 = iconst i64 3
    v4 = iconst i64 4
    v5 = iconst i64 5
    v6 = iconst i64 6
    v7 = iconst i64 7
    v8 = iconst i64 8
    v9 = iconst i64 9
    v10 = iadd v0, v1
    v11 = iadd v10, v2
    v12 = iadd v11, v3
    v13 = iadd v12, v4
    v14 = iadd v13, v5
    v15 = iadd v14, v6
    v16 = iadd v15, v7
    v17 = iadd v16, v8
    v18 = iadd v17, v9
    return v18
}
