; test x86_64
; nine simultaneously live values fit exactly in the allocatable registers
; check: nine:
; check: ret
function %nine() -> i64 {
block0:
    v0 = iconst 0
    v1 = iconst 1
    v2 = iconst 2
    v3 = iconst 3
    v4 = iconst 4
    v5 = iconst 5
    v6 = iconst 6
    v7 = iconst 7
    v8 = iconst 8
    v9 = iadd v0, v1
    v10 = iadd v9, v2
    v11 = iadd v10, v3
    v12 = iadd v11, v4
    v13 = iadd v12, v5
    v14 = iadd v13, v6
    v15 = iadd v14, v7
    v16 = iadd v15, v8
    return v16
}
