; test verify
; check: the terminator of block3 uses v3, whose definition does not dominate the use
function %f(i64) -> i64 {
block0(v0: i64):
    v100 = iconst i64 0
    v101 = icmp ne v0, v100
    brif v101, block1, block2

block1:
    v1 = iconst i64 1
    jump block3

block2:
    jump block3

block3:
    return v1
}
