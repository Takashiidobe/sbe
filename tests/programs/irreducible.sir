function %irreducible(i64, i64) -> i64 {
block0(v0: i64, v1: i64):
    v2 = iconst 0
    v100 = iconst 0
    v101 = icmp ne v0, v100
    brif v101, block1(v1, v2), block2(v1, v2)

block1(v3: i64, v4: i64):
    v5 = iconst 1
    v6 = iadd v4, v5
    v7 = iconst -1
    v8 = iadd v3, v7
    v102 = iconst 0
    v103 = icmp ne v8, v102
    brif v103, block2(v8, v6), block3(v6)

block2(v9: i64, v10: i64):
    v11 = iconst 10
    v12 = iadd v10, v11
    v13 = iconst -1
    v14 = iadd v9, v13
    v104 = iconst 0
    v105 = icmp ne v14, v104
    brif v105, block1(v14, v12), block3(v12)

block3(v15: i64):
    return v15
}
