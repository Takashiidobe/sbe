function %swap_n(i64, i64, i64) -> i64 {
block0(v0: i64, v1: i64, v2: i64):
    jump block1(v0, v1, v2)

block1(v3: i64, v4: i64, v5: i64):
    v6 = iconst i64 -1
    v7 = iadd v3, v6
    v100 = iconst i64 0
    v101 = icmp ne v7, v100
    brif v101, block1(v7, v5, v4), block2(v5)

block2(v8: i64):
    return v8
}
