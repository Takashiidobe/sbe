import %hyp(f64, i64, f32) -> f64

function %axpy(f64, f64, f64) -> f64 {
block0(v0: f64, v1: f64, v2: f64):
    v3 = fmul v0, v1
    v4 = fadd v3, v2
    return v4
}

function %mean32(f32, f32) -> f32 {
block0(v0: f32, v1: f32):
    v2 = fadd v0, v1
    v3 = fconst f32 0x3f000000
    v4 = fmul v2, v3
    return v4
}

function %sub_div(f64, f64) -> f64 {
block0(v0: f64, v1: f64):
    v2 = fsub v0, v1
    v3 = fdiv v2, v1
    return v3
}

function %cmp_all(f64, f64) -> i64 {
block0(v0: f64, v1: f64):
    v2 = fcmp eq v0, v1
    v3 = fcmp ne v0, v1
    v4 = fcmp lt v0, v1
    v5 = fcmp le v0, v1
    v6 = fcmp gt v0, v1
    v7 = fcmp ge v0, v1
    v8 = uextend i64 v2
    v9 = uextend i64 v3
    v10 = uextend i64 v4
    v11 = uextend i64 v5
    v12 = uextend i64 v6
    v13 = uextend i64 v7
    v14 = iconst i64 1
    v15 = ishl v9, v14
    v16 = iconst i64 2
    v17 = ishl v10, v16
    v18 = iconst i64 3
    v19 = ishl v11, v18
    v20 = iconst i64 4
    v21 = ishl v12, v20
    v22 = iconst i64 5
    v23 = ishl v13, v22
    v24 = bor v8, v15
    v25 = bor v24, v17
    v26 = bor v25, v19
    v27 = bor v26, v21
    v28 = bor v27, v23
    return v28
}

function %cmp_all32(f32, f32) -> i64 {
block0(v0: f32, v1: f32):
    v2 = fcmp lt v0, v1
    v3 = fcmp ge v0, v1
    v4 = uextend i64 v2
    v5 = uextend i64 v3
    v6 = iconst i64 1
    v7 = ishl v5, v6
    v8 = bor v4, v7
    return v8
}

function %to_int(f64) -> i64 {
block0(v0: f64):
    v1 = fcvt_to_sint i64 v0
    return v1
}

function %to_int32(f32) -> i32 {
block0(v0: f32):
    v1 = fcvt_to_sint i32 v0
    return v1
}

function %roundtrip(i64) -> i64 {
block0(v0: i64):
    v1 = fcvt_from_sint f64 v0
    v2 = fcvt_to_sint i64 v1
    return v2
}

function %small_to_float(i32) -> f32 {
block0(v0: i32):
    v1 = ireduce i16 v0
    v2 = fcvt_from_sint f32 v1
    return v2
}

function %widen(f32) -> f64 {
block0(v0: f32):
    v1 = fpromote f64 v0
    return v1
}

function %narrow(f64) -> f32 {
block0(v0: f64):
    v1 = fdemote f32 v0
    return v1
}

function %bits(f64) -> i64 {
block0(v0: f64):
    v1 = bitcast i64 v0
    return v1
}

function %from_bits(i64) -> f64 {
block0(v0: i64):
    v1 = bitcast f64 v0
    return v1
}

function %fsum(i64) -> f64 {
block0(v0: i64):
    v1 = iconst i64 0
    v2 = fconst f64 0x0
    jump block1(v1, v2)

block1(v3: i64, v4: f64):
    v5 = icmp slt v3, v0
    brif v5, block2, block3

block2:
    v6 = fcvt_from_sint f64 v3
    v7 = fadd v4, v6
    v8 = iconst i64 1
    v9 = iadd v3, v8
    jump block1(v9, v7)

block3:
    return v4
}

function %mixed(i64, f64, i32, f32) -> f64 {
block0(v0: i64, v1: f64, v2: i32, v3: f32):
    v4 = fcvt_from_sint f64 v0
    v5 = fadd v4, v1
    v6 = fcvt_from_sint f64 v2
    v7 = fadd v5, v6
    v8 = fpromote f64 v3
    v9 = fadd v7, v8
    return v9
}

function %max_of(f64, f64) -> f64 {
block0(v0: f64, v1: f64):
    v2 = fcmp gt v0, v1
    v3 = select v2, v0, v1
    return v3
}

function %via_memory(f64, f32) -> f64 {
    ss0 = stack_slot 16

block0(v0: f64, v1: f32):
    v2 = stack_addr ss0
    v3 = iconst i64 8
    v4 = iadd v2, v3
    store v0, v2
    store v1, v4
    v5 = load f64 v2
    v6 = load f32 v4
    v7 = fpromote f64 v6
    v8 = fadd v5, v7
    return v8
}

function %call_hyp(f64, i64, f32) -> f64 {
    fn0 = %hyp(f64, i64, f32) -> f64

block0(v0: f64, v1: i64, v2: f32):
    v3 = call fn0(v0, v1, v2)
    v4 = fconst f64 0x3ff0000000000000
    v5 = fadd v3, v4
    return v5
}
